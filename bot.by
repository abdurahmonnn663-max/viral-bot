import os import logging import asyncio from telegram import Update from telegram.ext import ( Application, CommandHandler, MessageHandler, filters, ContextTypes ) from processor import VideoProcessor logging.basicConfig( format="%(asctime)s - %(levelname)s - %(message)s", level=logging.INFO ) logger = logging.getLogger(name) BOT_TOKEN = os.getenv("BOT_TOKEN", "YOUR_BOT_TOKEN_HERE") processor = VideoProcessor() async def start(update: Update, context: ContextTypes.DEFAULT_TYPE): await update.message.reply_text( "🎬 *AI Video Style Bot*\n\n" "Send me a YouTube link and I will recreate it with AI visual effects!\n\n" "🆓 100% FREE — No API keys needed\n\n" "Just paste a YouTube URL below 👇", parse_mode="Markdown" ) async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE): await update.message.reply_text( "📖 *How to use:*\n\n" "1. Copy a YouTube link\n" "2. Paste it here\n" "3. Wait 1-3 minutes\n" "4. Get your AI-styled video!\n\n" "✨ *Effects applied:*\n" "• Cinematic color grading\n" "• AI scene enhancement\n" "• Film grain & vignette\n" "• Dynamic contrast boost\n" "• Style transfer filters", parse_mode="Markdown" ) async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE): text = update.message.text.strip() if "youtube.com/watch" in text or "youtu.be/" in text or "youtube.com/shorts" in text: msg = await update.message.reply_text("⏳ *Step 1/4:* Downloading video...") await process_video(update, context, text, msg) else: await update.message.reply_text( "❌ Please send a valid YouTube URL.\n\n" "Example:\nhttps://youtube.com/watch?v=xxxxx", parse_mode="Markdown" ) async def process_video(update, context, url, status_msg): chat_id = update.message.chat_id try: video_path = await asyncio.to_thread(processor.download, url) await status_msg.edit_text("🎨 *Step 2/4:* Analyzing scenes...") info = await asyncio.to_thread(processor.get_video_info, video_path) await status_msg.edit_text( f"✨ *Step 3/4:* Applying AI effects...\n\n" f"📹 Duration: {info['duration']:.1f}s\n" f"🎬 FPS: {info['fps']:.0f}\n" f"📐 Resolution: {info['width']}x{info['height']}", parse_mode="Markdown" ) output_path = await asyncio.to_thread(processor.apply_effects, video_path) await status_msg.edit_text("📤 *Step 4/4:* Sending your video...") size_mb = os.path.getsize(output_path) / (1024 * 1024) if size_mb > 50: await status_msg.edit_text( "⚠️ Video too large (>50MB).\nTry a shorter video (under 3 minutes)." ) else: with open(output_path, "rb") as f: await context.bot.send_video( chat_id=chat_id, video=f, caption=( "🎬 *AI Recreated Video*\n\n" "✅ Cinematic color grading\n" "✅ Scene enhancement\n" "✅ Film grain & vignette\n" "✅ Dynamic contrast\n\n" "Send another YouTube link! 🚀" ), parse_mode="Markdown", supports_streaming=True ) await status_msg.delete() processor.cleanup([video_path, output_path]) except Exception as e: logger.error(f"Error: {e}") await status_msg.edit_text( f"❌ *Error:* {str(e)}\n\nTry a shorter video (< 3 min)."
